<project name="MyProject" default="junit" basedir=".">
	<description>
    simple example build file
  </description>

	<property name="src" location="src" />
	<property name="test" location="test" />
	<property name="build" location="build" />

	<target name="init">
		<tstamp />
		<mkdir dir="${build}" />
	</target>

	<property name="lib" location="${build}/lib" />
	<property name="maven" value="https://repo1.maven.org/maven2" />

	<target name="resolve" depends="init" description="download JUnit 4 and Hamcrest from Maven Central">
		<mkdir dir="${lib}" />
		<get src="${maven}/junit/junit/4.13.2/junit-4.13.2.jar" dest="${lib}" skipexisting="true" />
		<get src="${maven}/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar" dest="${lib}" skipexisting="true" />
		<checksum file="${lib}/junit-4.13.2.jar" algorithm="SHA-256" property="8e495b634469d64fb8acfa3495a065cbacc8a0fff55ce1e31007be4c16dc57d3" verifyproperty="junit.ok" />
		<checksum file="${lib}/hamcrest-core-1.3.jar" algorithm="SHA-256" property="66fdef91e9739348df7a096aa384a5685f4e875584cce89386a7a47251c4d8e9" verifyproperty="hamcrest.ok" />
		<fail message="Checksum mismatch of a downloaded JAR file.">
			<condition>
				<not><and><istrue value="${junit.ok}" /><istrue value="${hamcrest.ok}" /></and></not>
			</condition>
		</fail>
	</target>

	<path id="path.junit">
		<fileset dir="${lib}" includes="*.jar" erroronmissingdir="false" />
	</path>

	<target name="compile" depends="resolve" description="compile the source">
		<javac destdir="${build}" includeantruntime="false">
			<src path="${src}" />
			<src path="${test}" />
			<classpath>
				<path refid="path.junit"/>
			</classpath>
		</javac>
	</target>

	<target name="junit" depends="compile">
		<junit haltonerror="true" printsummary="true">
			<classpath>
				<path refid="path.junit"/>
				<pathelement location="${build}"/>
			</classpath>
			<formatter type="xml"/>
		    <batchtest fork="false" todir="${build}">
		        <fileset dir="${test}">
		            <include name="**/*Test.java"/>
		            <include name="**/AllTests.java"/>
		        </fileset>
		    </batchtest>
		</junit>
	</target>

	<target name="clean" description="clean up">
		<delete dir="${build}" />
		<delete dir="${dist}" />
	</target>
</project>
